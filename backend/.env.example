# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Anthropic -------------------------------------------------------------
# The SDK reads this variable directly.
ANTHROPIC_API_KEY=sk-ant-...

# --- MongoDB Atlas ---------------------------------------------------------
# From Atlas: Connect -> Drivers. Percent-encode special characters in the
# password, and add your IP under Network Access or the connection will hang.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=uit_ecommerce_chatbot

# --- Embeddings ------------------------------------------------------------
# "auto"     Atlas generates and syncs Voyage embeddings. No key needed here.
# "explicit" This app computes vectors itself and needs VOYAGE_API_KEY below.
EMBEDDING_MODE=auto
VOYAGE_MODEL=voyage-4
# VOYAGE_API_KEY=pa-...

# --- Models ----------------------------------------------------------------
AGENT_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5
AGENT_EFFORT=high

# --- HTTP ------------------------------------------------------------------
# JSON array. Add your deployed frontend origin before going live.
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
