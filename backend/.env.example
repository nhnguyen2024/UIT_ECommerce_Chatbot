# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Model provider ----------------------------------------------------------
# "anthropic"    calls Anthropic's API with ANTHROPIC_API_KEY.
# "cortex"       calls Claude through Snowflake Cortex with SNOWFLAKE_ACCOUNT_URL
#                and SNOWFLAKE_PAT (infra/snowflake/setup.sql). Not on trials.
# "azure_openai" calls an Azure OpenAI deployment with AZURE_OPENAI_ENDPOINT and
#                AZURE_OPENAI_API_KEY. Set AGENT_MODEL and CLASSIFIER_MODEL to
#                deployment names, and the PRICE_* values below to that model's.
# After changing provider, run: .venv/bin/python -m app.agent.probe
LLM_PROVIDER=anthropic

# Only for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Only for LLM_PROVIDER=cortex. The account URL has no path, e.g.
# https://myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=https://ORGNAME-ACCOUNTNAME.snowflakecomputing.com
SNOWFLAKE_PAT=

# Only for LLM_PROVIDER=azure_openai. The resource root, no path, e.g.
# https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=

# Features a provider may not accept. Keep true for Anthropic; for Cortex, set
# these to whatever app.agent.probe reports.
LLM_STRICT_TOOLS=true
LLM_EFFORT=true

# --- MongoDB Atlas ---------------------------------------------------------
# From Atlas: Connect -> Drivers. Percent-encode special characters in the
# password, and add your IP under Network Access or the connection will hang.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=uit_ecommerce_chatbot

# --- Embeddings ------------------------------------------------------------
# "auto"     Atlas generates and syncs Voyage embeddings. No key needed here.
# "explicit" This app computes vectors itself and needs VOYAGE_API_KEY below.
EMBEDDING_MODE=auto
VOYAGE_MODEL=voyage-4
# VOYAGE_API_KEY=pa-...

# --- Models ----------------------------------------------------------------
AGENT_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5
# Anthropic: low | medium | high | xhigh | max.  Azure OpenAI: minimal | low | medium | high.
AGENT_EFFORT=high

# --- Cost estimate (telemetry only) -----------------------------------------
# USD per million tokens for the agent model. Defaults are Claude Opus 5's.
# For gpt-5-mini on Azure (GlobalStandard): 0.25 / 2.00 / 0.025.
# PRICE_INPUT_PER_MTOK=5.00
# PRICE_OUTPUT_PER_MTOK=25.00
# PRICE_CACHE_READ_PER_MTOK=0.50

# --- HTTP ------------------------------------------------------------------
# JSON array. Add your deployed frontend origin before going live.
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
